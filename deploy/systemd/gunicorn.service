[Unit]
Description=gunicorn daemon
After=network.target

[Service]
User=<USER>
Group=www-data
WorkingDirectory=<APP_DIR>
ExecStart=<CONDA_ENV_DIR>/bin/gunicorn --access-logfile - --workers 5 --bind unix:/var/log/gunicorn/microwarrior.sock microwarrior.wsgi:application

[Install]
WantedBy=multi-user.target
