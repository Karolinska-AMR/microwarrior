# Copy to microwarrior/.env and fill in. Paths may be absolute or relative to
# the directory the app is started from.

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# send cookies only over https (default: on when DEBUG=False)
SECURE_COOKIES=True

# Celery: RabbitMQ broker, task results in a local SQLite file
CELERY_BROKER_URL=amqp://<user>:<password>@localhost:5672//
CELERY_RESULT_BACKEND=db+sqlite:///tasks_q.sqlite3

# Folder that contains db.sqlite3 (defaults to the project folder)
SQLITE_DB=/path/to/db

# spear-mtb checkout (contains spear-mtb.sh and main.config)
WORKFLOW_ROOT=/path/to/spear-mtb
# uploaded fastq files, one sub-folder per ticket
MEDIA_ROOT=/path/to/uploads
# nextflow work directory
WORKING_ROOT=/path/to/working_dir
# reference assets used by the pipeline
ASSETS_ROOT=/path/to/assets
# pipeline output: reports/<ticket>.json, traces/<ticket>.trace
ARCHIVE_ROOT=/path/to/spear_out
# archive of raw sequences
RAWSEQ_ROOT=/path/to/raw_seq

# optional (default: <project>/static and <project>/logs)
STATIC_ROOT=/var/www/static
LOG_DIR=/path/to/logs
